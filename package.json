{
  "name": "recalls-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3050",
    "build": "npm run build:es && npm run build:en",
    "build:es": "node scripts/build-locale.mjs es",
    "build:en": "node scripts/build-locale.mjs en",
    "import": "tsx scripts/import-safety-gate.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.0.8",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/oxide-wasm32-wasi": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.17.19",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "eslint": "9.20.1",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
